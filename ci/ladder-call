#!/usr/bin/env python3
import argparse
import base64
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parent
DEFAULT_LANES = REPO / 'lanes.json'
SKIP_HTTP = {401, 402, 403, 404, 408, 425, 429}
IMAGE_SKIP_HTTP = {400, 415, 422}
IMAGE_MEDIA = {'.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg'}
MAX_IMAGES = 8
MAX_IMAGE_BYTES = 2 * 1024 * 1024
MAX_TOTAL_BYTES = 6 * 1024 * 1024
CURSOR_RATE_MARKERS = (
    'rate limit',
    'rate_limit',
    'rate-limit',
    'too many requests',
    'quota exceeded',
    'resource exhausted',
)

sys.path.insert(0, str(REPO))
from model_families import filter_lanes, model_family
from verdict import answer_text, find_verdict


def timeout_seconds():
    raw = os.environ.get('LADDER_CALL_TIMEOUT', '').strip()
    if not raw:
        return 240
    try:
        return int(raw)
    except ValueError:
        return 240


def lanes_path():
    override = os.environ.get('LADDER_CALL_LANES')
    return Path(override) if override else DEFAULT_LANES


def image_paths(raw):
    return [part.strip() for part in re.split(r'[,\n]', raw or '') if part.strip()]


def load_images(raw):
    paths = image_paths(raw)
    if len(paths) > MAX_IMAGES:
        raise ValueError(f'{len(paths)} images given, at most {MAX_IMAGES} fit')
    images = []
    total = 0
    for value in paths:
        path = Path(value)
        media = IMAGE_MEDIA.get(path.suffix.lower())
        if not media:
            raise ValueError(f'{value}: not a .png, .jpg or .jpeg file')
        if not path.is_file():
            raise ValueError(f'{value}: not a file')
        size = path.stat().st_size
        if size > MAX_IMAGE_BYTES:
            raise ValueError(f'{value}: {size} bytes is over the {MAX_IMAGE_BYTES} byte per-image cap')
        total += size
        if total > MAX_TOTAL_BYTES:
            raise ValueError(f'images total {total} bytes, over the {MAX_TOTAL_BYTES} byte cap')
        encoded = base64.b64encode(path.read_bytes()).decode()
        images.append({'name': path.name, 'url': f'data:{media};base64,{encoded}'})
    return images


def image_note(images):
    names = ', '.join(image['name'] for image in images)
    return f'Attached images, in this order: {names}. Judges that need them: read the screenshots.'


def image_content(images):
    parts = [{'type': 'text', 'text': image_note(images)}]
    parts.extend(
        {'type': 'image_url', 'image_url': {'url': image['url']}} for image in images
    )
    return parts


def with_images(body, images):
    if not images:
        return body
    payload = dict(body)
    messages = list(payload.get('messages') or [])
    for index in range(len(messages) - 1, -1, -1):
        message = messages[index]
        if not isinstance(message, dict) or message.get('role') != 'user':
            continue
        content = message.get('content')
        if isinstance(content, list):
            messages[index] = dict(message, content=content + image_content(images))
            payload['messages'] = messages
            return payload
        if isinstance(content, str) and content.strip():
            merged = [{'type': 'text', 'text': content}] + image_content(images)
            messages[index] = dict(message, content=merged)
            payload['messages'] = messages
            return payload
        break
    messages.append({'role': 'user', 'content': image_content(images)})
    payload['messages'] = messages
    return payload


def lane_url(lane):
    key = 'LADDER_CALL_URL_' + lane['name'].upper().replace('-', '_')
    return os.environ.get(key, lane['url'])


def load_lanes():
    with open(lanes_path(), encoding='utf-8') as fh:
        return json.load(fh)


def message_content(result):
    try:
        choices = result.get('choices') or []
        if not choices:
            return ''
        msg = choices[0].get('message') or {}
        content = msg.get('content')
        if content is None:
            return ''
        if isinstance(content, str):
            return content.strip()
        if isinstance(content, list):
            parts = []
            for part in content:
                if isinstance(part, dict):
                    if part.get('type') == 'text':
                        parts.append(part.get('text') or '')
                    elif 'text' in part:
                        parts.append(part.get('text') or '')
                elif isinstance(part, str):
                    parts.append(part)
            return ''.join(parts).strip()
        return ''
    except (AttributeError, IndexError, KeyError, TypeError):
        return ''


def messages_prompt(body):
    messages = body.get('messages')
    if not isinstance(messages, list):
        return ''
    parts = []
    for message in messages:
        if not isinstance(message, dict):
            continue
        role = message.get('role') or 'user'
        content = message.get('content')
        if content is None:
            continue
        if isinstance(content, str):
            text = content.strip()
        elif isinstance(content, list):
            text = message_content({'choices': [{'message': {'content': content}}]})
        else:
            text = str(content).strip()
        if text:
            parts.append(f'{role}: {text}')
    return '\n'.join(parts)


def cursor_agent_bin():
    override = os.environ.get('LADDER_CALL_CURSOR_AGENT', '').strip()
    if override:
        return override
    found = shutil.which('cursor-agent')
    if found:
        return found
    candidate = Path.home() / '.local' / 'bin' / 'cursor-agent'
    if candidate.is_file():
        return str(candidate)
    return ''


def cursor_rate_limited(text):
    lower = text.lower()
    return any(marker in lower for marker in CURSOR_RATE_MARKERS)


def call_cursor_lane(lane, key, body):
    prompt = messages_prompt(body)
    if not prompt:
        return None, 'empty answer'
    bin_path = cursor_agent_bin()
    if not bin_path:
        return None, 'no cursor-agent'
    model = lane.get('model') or 'composer-2.5'
    env = os.environ.copy()
    env['CURSOR_API_KEY'] = key
    cmd = [bin_path, '-p', '--output-format', 'text', '--model', model, prompt]
    try:
        proc = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=timeout_seconds(),
            env=env,
            stdin=subprocess.DEVNULL,
        )
    except subprocess.TimeoutExpired:
        return None, 'timeout'
    except OSError as exc:
        return None, type(exc).__name__
    if proc.returncode != 0:
        return None, f'exit {proc.returncode}'
    text = (proc.stdout or '').strip()
    if not text:
        return None, 'empty answer'
    if cursor_rate_limited(text):
        return None, 'rate limit'
    return {'choices': [{'message': {'content': text}}]}, None


def gateway_tags(env):
    def slug(value, default):
        return value.lower() if re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]*', value) else default

    repo = slug(env.get('GITHUB_REPOSITORY', '').rsplit('/', 1)[-1], 'token-ladder')
    job = slug(env.get('GITHUB_JOB', ''), 'cli')
    caller = slug(env.get('LADDER_CALL_CALLER', ''), job)
    tag = f'caller={repo}-{caller}'
    if len(tag) > 64:
        tag = tag[:51] + '-' + hashlib.sha256(tag.encode()).hexdigest()[:12]
    tags = [tag]
    pr = env.get('LADDER_CALL_PR', '')
    if env.get('GITHUB_EVENT_NAME') in ('pull_request', 'pull_request_target') and re.fullmatch(r'[1-9][0-9]{0,9}', pr):
        tags.append(f'pr={pr}')
    return tags


def call_lane(lane, key, body, images=False):
    url = lane_url(lane)
    headers = {
        'Authorization': 'Bearer ' + key,
        'Content-Type': 'application/json',
        'User-Agent': 'token-ladder-ladder-call/1',
    }
    if lane['name'] == 'vercel-ai-gateway':
        headers['ai-reporting-tags'] = ','.join(gateway_tags(os.environ))
    if lane['name'] == 'opencode-go':
        if os.environ.get('GITHUB_RUN_ID'):
            headers['x-opencode-session'] = os.environ['GITHUB_RUN_ID']
        else:
            headers['x-opencode-session'] = 'token-ladder-ladder-call'
    payload = dict(body)
    payload['model'] = lane['model']
    gateway = lane.get('gateway')
    if isinstance(gateway, dict) and gateway:
        payload['providerOptions'] = {'gateway': gateway}
    provider = lane.get('provider')
    if isinstance(provider, dict) and provider:
        payload['provider'] = provider
    req = urllib.request.Request(url, data=json.dumps(payload).encode(), headers=headers)
    with urllib.request.urlopen(req, timeout=timeout_seconds()) as response:
        raw = response.read()
        if not raw.strip():
            return None
        try:
            return json.loads(raw)
        except json.JSONDecodeError:
            return None


def skip_reason(lane, exc=None, status=None, empty=False):
    if empty:
        return 'empty answer'
    if exc is not None:
        if isinstance(exc, urllib.error.HTTPError):
            return str(exc.code)
        if isinstance(exc, TimeoutError):
            return 'timeout'
        return type(exc).__name__
    return str(status)


DECIDE_SYSTEM = (
    'You are the verdict line of an independent pull request verifier. '
    'You did not write the change. Decide from the verifier notes you are given, which may '
    'be cut short. '
    'Your first line must be exactly PASS, PASS+NOTES, or FAIL, alone, with no markdown. '
    'Then at most three short lines.'
)
DECIDE_TAIL = 4000
DECIDE_TOKENS = 2048


def log_skip(name, reason):
    print(f'ladder-call: lane {name} skipped: {reason}', file=sys.stderr)


def flatten(text, limit=300):
    flat = ' '.join((text or '').split())
    return flat[-limit:]


def decide_request(answer):
    notes = (answer or '').strip()[-DECIDE_TAIL:]
    return {
        'messages': [
            {'role': 'system', 'content': DECIDE_SYSTEM},
            {
                'role': 'user',
                'content': (
                    'A PR verifier reviewed a diff and wrote these notes, possibly cut short:\n\n'
                    + notes
                    + '\n\nDecide now from these notes. First line exactly PASS, PASS+NOTES, '
                    'or FAIL, alone. Then at most three short lines.'
                ),
            },
        ],
        'max_tokens': DECIDE_TOKENS,
    }


def attempt_lane(lane, key, body, images=False):
    try:
        if lane.get('kind') == 'cursor':
            return call_cursor_lane(lane, key, body)
        return call_lane(lane, key, body, images=images), None
    except urllib.error.HTTPError as exc:
        if images and exc.code in IMAGE_SKIP_HTTP:
            return None, f'{exc.code} with images'
        if exc.code in SKIP_HTTP or exc.code >= 500:
            return None, skip_reason(lane, exc=exc)
        print(
            f'ladder-call: lane {lane["name"]} failed: HTTP {exc.code}',
            file=sys.stderr,
        )
        raise SystemExit(1)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        if isinstance(getattr(exc, 'reason', None), TimeoutError):
            return None, 'timeout'
        return None, skip_reason(lane, exc=exc)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--purpose', required=True)
    parser.add_argument('--require-verdict', action='store_true')
    parser.add_argument('--exclude-families', default='', help='Comma-separated model families to skip')
    parser.add_argument('--images', default=os.environ.get('LADDER_CALL_IMAGES', ''),
                        help='Comma- or newline-separated PNG/JPEG paths to send as image parts')
    args = parser.parse_args()
    require_verdict = args.require_verdict or os.environ.get('LADDER_CALL_REQUIRE_VERDICT') == '1'
    try:
        body = json.load(sys.stdin)
    except json.JSONDecodeError:
        print('ladder-call: invalid JSON on stdin', file=sys.stderr)
        raise SystemExit(2)
    try:
        images = load_images(args.images)
    except (ValueError, OSError) as exc:
        print(f'ladder-call: {exc}', file=sys.stderr)
        raise SystemExit(2)
    if images:
        print(f'ladder-call: attaching {len(images)} image(s)', file=sys.stderr)
    lanes = load_lanes()
    try:
        excluded = {model_family(family) for family in args.exclude_families.split(',') if family.strip()}
        eligible = filter_lanes(lanes, excluded)
    except ValueError as exc:
        print(f'ladder-call: cannot enforce family exclusions: {exc}', file=sys.stderr)
        raise SystemExit(2)
    for lane in lanes:
        if lane not in eligible:
            log_skip(lane['name'], f'excluded family {model_family(lane["model"])}')
    if excluded and not eligible:
        print('ladder-call: all lanes excluded by author model families', file=sys.stderr)
        raise SystemExit(3)
    for lane in eligible:
        key = os.environ.get(lane['key_env'], '').strip()
        if not key:
            log_skip(lane['name'], 'no key')
            continue
        if images and not lane.get('vision'):
            log_skip(lane['name'], 'no vision')
            continue
        result, reason = attempt_lane(lane, key, with_images(body, images), images=bool(images))
        if reason:
            log_skip(lane['name'], reason)
            continue
        if result is None:
            log_skip(lane['name'], 'invalid response')
            continue
        answer = answer_text(result)
        if not answer:
            log_skip(lane['name'], 'empty answer')
            continue
        if require_verdict and not find_verdict(answer)[0]:
            print(
                f'ladder-call: lane {lane["name"]} no-verdict answer tail: {flatten(answer, 600)}',
                file=sys.stderr,
            )
            result, reason = attempt_lane(lane, key, decide_request(answer))
            if reason:
                log_skip(lane['name'], reason)
                continue
            decision = answer_text(result) if result else ''
            if not find_verdict(decision)[0]:
                log_skip(lane['name'], 'no verdict')
                continue
            answer = decision
        print(f'ladder-call: lane {lane["name"]} answered ({args.purpose})', file=sys.stderr)
        json.dump(result, sys.stdout)
        print()
        return
    print('ladder-call: no lane answered', file=sys.stderr)
    raise SystemExit(3)


if __name__ == '__main__':
    main()