#!/usr/bin/env python3
import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parent
DEFAULT_LANES = REPO / 'lanes.json'
SKIP_HTTP = {401, 402, 403, 404, 408, 425, 429}

sys.path.insert(0, str(REPO))
from verdict import answer_text, find_verdict


def timeout_seconds():
    raw = os.environ.get('LADDER_CALL_TIMEOUT', '').strip()
    if not raw:
        return 240
    try:
        return int(raw)
    except ValueError:
        return 240


def lanes_path():
    override = os.environ.get('LADDER_CALL_LANES')
    return Path(override) if override else DEFAULT_LANES


def lane_url(lane):
    key = 'LADDER_CALL_URL_' + lane['name'].upper().replace('-', '_')
    return os.environ.get(key, lane['url'])


def load_lanes():
    with open(lanes_path(), encoding='utf-8') as fh:
        return json.load(fh)


def call_lane(lane, key, body):
    url = lane_url(lane)
    headers = {
        'Authorization': 'Bearer ' + key,
        'Content-Type': 'application/json',
        'User-Agent': 'token-ladder-ladder-call/1',
    }
    if lane['name'] == 'opencode-go' and os.environ.get('GITHUB_RUN_ID'):
        headers['x-opencode-session'] = os.environ['GITHUB_RUN_ID']
    payload = dict(body)
    payload['model'] = lane['model']
    req = urllib.request.Request(url, data=json.dumps(payload).encode(), headers=headers)
    with urllib.request.urlopen(req, timeout=timeout_seconds()) as response:
        raw = response.read()
        if not raw.strip():
            return None
        try:
            return json.loads(raw)
        except json.JSONDecodeError:
            return None


def skip_reason(lane, exc=None, status=None, empty=False):
    if empty:
        return 'empty answer'
    if exc is not None:
        if isinstance(exc, urllib.error.HTTPError):
            return str(exc.code)
        if isinstance(exc, TimeoutError):
            return 'timeout'
        return type(exc).__name__
    return str(status)


def log_skip(name, reason):
    print(f'ladder-call: lane {name} skipped: {reason}', file=sys.stderr)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--purpose', required=True)
    parser.add_argument('--require-verdict', action='store_true')
    args = parser.parse_args()
    require_verdict = args.require_verdict or os.environ.get('LADDER_CALL_REQUIRE_VERDICT') == '1'
    try:
        body = json.load(sys.stdin)
    except json.JSONDecodeError:
        print('ladder-call: invalid JSON on stdin', file=sys.stderr)
        raise SystemExit(2)
    lanes = load_lanes()
    for lane in lanes:
        key = os.environ.get(lane['key_env'], '').strip()
        if not key:
            log_skip(lane['name'], 'no key')
            continue
        try:
            result = call_lane(lane, key, body)
        except urllib.error.HTTPError as exc:
            if exc.code in SKIP_HTTP:
                log_skip(lane['name'], skip_reason(lane, exc=exc))
                continue
            if exc.code >= 500:
                log_skip(lane['name'], skip_reason(lane, exc=exc))
                continue
            print(
                f'ladder-call: lane {lane["name"]} failed: HTTP {exc.code}',
                file=sys.stderr,
            )
            raise SystemExit(1)
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            if isinstance(getattr(exc, 'reason', None), TimeoutError):
                log_skip(lane['name'], 'timeout')
            else:
                log_skip(lane['name'], skip_reason(lane, exc=exc))
            continue
        if result is None:
            log_skip(lane['name'], 'invalid response')
            continue
        answer = answer_text(result)
        if not answer:
            log_skip(lane['name'], 'empty answer')
            continue
        if require_verdict and not find_verdict(answer)[0]:
            log_skip(lane['name'], 'no verdict')
            continue
        print(f'ladder-call: lane {lane["name"]} answered ({args.purpose})', file=sys.stderr)
        json.dump(result, sys.stdout)
        print()
        return
    print('ladder-call: no lane answered', file=sys.stderr)
    raise SystemExit(3)


if __name__ == '__main__':
    main()