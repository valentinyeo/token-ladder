#!/usr/bin/env python3
import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

LINT = Path(__file__).resolve().parent / 'lint-direct-model-calls'
GOOGLE = re.compile(r'generativelanguage\.googleapis\.com')
EXTRA_KEY = re.compile(r'\b(CLAUDE_CODE_OAUTH_TOKEN|CODEX_AUTH_JSON)\b')
LADDER = re.compile(
    r'ladder-call|token-ladder/\.github/actions/ladder-call',
    re.IGNORECASE,
)
LINT_HIT = re.compile(r'^(.+):(\d+): direct model call \((.+)\):')
SCAN_ROOTS = ('.github', 'tools')
def run_lint(repo):
    result = subprocess.run(
        [sys.executable, str(LINT), str(repo)],
        capture_output=True,
        text=True,
        check=False,
    )
    hits = []
    lines = result.stdout.splitlines()
    index = 0
    while index < len(lines):
        match = LINT_HIT.match(lines[index])
        if match:
            hits.append((match.group(1), int(match.group(2)), match.group(3)))
            index += 1
            if index < len(lines) and lines[index].startswith('  '):
                index += 1
            continue
        index += 1
    return hits


def scan_extra(repo):
    hits = []
    for name in SCAN_ROOTS:
        root = repo / name
        if not root.is_dir():
            continue
        for path in sorted(root.rglob('*')):
            if not path.is_file():
                continue
            try:
                text = path.read_text(encoding='utf-8', errors='replace')
            except OSError:
                continue
            for lineno, line in enumerate(text.splitlines(), 1):
                if GOOGLE.search(line):
                    hits.append((str(path), lineno, 'generativelanguage.googleapis.com'))
                key_match = EXTRA_KEY.search(line)
                if key_match:
                    label = key_match.group(1)
                    hits.append((str(path), lineno, f'direct model key ({label})'))
    return hits


def uses_ladder(repo):
    github = repo / '.github'
    if not github.is_dir():
        return False
    for path in github.rglob('*'):
        if not path.is_file():
            continue
        try:
            if LADDER.search(path.read_text(encoding='utf-8', errors='replace')):
                return True
        except OSError:
            continue
    return False


def gh_secret_names(full_name):
    result = subprocess.run(
        ['gh', 'secret', 'list', '-R', full_name, '--json', 'name'],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return ''
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        return ''
    return ', '.join(sorted(item['name'] for item in data))


def gh_repos(owner, limit):
    result = subprocess.run(
        [
            'gh', 'repo', 'list', owner,
            '--limit', str(limit),
            '--no-archived',
            '--json', 'nameWithOwner',
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise SystemExit(result.stderr or 'gh repo list failed')
    return [item['nameWithOwner'] for item in json.loads(result.stdout)]


def shallow_clone(full_name, clone_dir):
    short = full_name.split('/', 1)[1]
    dest = clone_dir / short
    if dest.is_dir():
        return dest
    clone_dir.mkdir(parents=True, exist_ok=True)
    subprocess.run(
        ['git', 'clone', '--depth', '1', f'https://github.com/{full_name}.git', str(dest)],
        capture_output=True,
        check=True,
    )
    return dest


def rel_file_line(repo, path, lineno):
    try:
        rel = Path(path).relative_to(repo).as_posix()
    except ValueError:
        rel = Path(path).as_posix()
    return f'{rel}:{lineno}'


def scan_repo(full_name, repo_path):
    ladder = 'yes' if uses_ladder(repo_path) else 'no'
    secrets = gh_secret_names(full_name)
    hits = []
    seen = set()
    for path, lineno, label in run_lint(repo_path) + scan_extra(repo_path):
        key = (path, lineno, label)
        if key in seen:
            continue
        seen.add(key)
        hits.append((full_name, rel_file_line(repo_path, path, lineno), label, secrets, ladder))
    return sorted(hits, key=lambda row: (row[0], row[1]))


def print_table(rows):
    print('repo\tfile:line\twhat it calls\tsecret names\tladder-call')
    for row in rows:
        print('\t'.join(row))


def resolve_repo_path(arg, clone_dir):
    path = Path(arg)
    if path.is_dir():
        return path.resolve()
    if '/' in arg:
        return shallow_clone(arg, clone_dir)
    raise SystemExit(f'not a repo directory: {arg}')


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--owner', default='')
    parser.add_argument('--limit', type=int, default=300)
    parser.add_argument('--clone-dir', type=Path, default=Path('/tmp/scan107/clones'))
    parser.add_argument('--no-clone', action='store_true')
    parser.add_argument('repos', nargs='*')
    args = parser.parse_args()
    targets = list(args.repos)
    if args.owner:
        targets.extend(gh_repos(args.owner, args.limit))
    if not targets:
        raise SystemExit('pass --owner or repo paths')
    rows = []
    for target in targets:
        if args.no_clone and '/' in target and not Path(target).is_dir():
            continue
        repo_path = resolve_repo_path(target, args.clone_dir) if not args.no_clone else Path(target).resolve()
        if not repo_path.is_dir():
            continue
        full_name = target if '/' in target else repo_path.name
        rows.extend(scan_repo(full_name, repo_path))
    print_table(rows)


if __name__ == '__main__':
    main()