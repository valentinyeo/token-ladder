#!/usr/bin/env python3
import subprocess
import sys


def changed_files(base, head):
    out = subprocess.run(["git", "diff", "--name-only", "--no-color", f"{base}...{head}"],
                         check=True, capture_output=True, text=True).stdout
    return [p for p in out.splitlines() if p]


def untested(paths):
    code = [p for p in paths if p.startswith("bin/")]
    return [] if any(p.startswith("tests/") for p in paths) else code


def main(argv):
    if len(argv) not in (2, 3):
        print("usage: check-tests-changed <base> [<head>]", file=sys.stderr)
        return 2
    missing = untested(changed_files(argv[1], argv[2] if len(argv) == 3 else "HEAD"))
    for path in missing:
        print(f"{path}: changed without a test; add or update one in tests/ that fails without this change")
    return 1 if missing else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
