#!/usr/bin/env python3
import argparse
import glob
import json
import math
import os
import re
import subprocess
import sys
import time
import urllib.request
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.realpath(__file__))
DEFAULT_PACE_WARN = 1.1
DEFAULT_LIMITED_HOURS = 1.0
DEFAULT_CREDIT_LIMITED_HOURS = 12.0
WORKER_SHIMS = os.path.join(HERE, "worker-shims")
TAIL_CHARS = 20000
ERROR_CHARS = 4000
CREDIT_ERROR = re.compile(r"\b402\b|payment required|insufficient[ _](balance|credits?|funds|quota)|"
                          r"out of credits?|credit balance|exceeded your current quota|no credits? (left|remaining)", re.I)
RATE_ERROR = re.compile(r"\b429\b|too many requests|rate[ _-]?limit|usage limit|quota|resource[ _]exhausted|"
                        r"limit (reached|exceeded)|hit your limit", re.I)
BLOCKED_ERROR = re.compile(r"requires a challenge|\"code\":\s*\"challenge\"", re.I)
PROVIDER_HTTP = re.compile(r"\bHTTP [45]\d{2}\b|statusCode[\"':\s]+[45]\d{2}", re.I)
MODEL_REJECTED = re.compile(r"model request was rejected", re.I)
PROVIDER_AUTH = re.compile(r"\b401\b|unauthorized|invalid[_ -]?api[_ -]?key|authentication failed", re.I)
PI_AGENT_FAST = re.compile(r"stopReason[\"']:\s*[\"']error[\"']", re.I)
FAST_FAIL_BEFORE_WORK_S = 30
PACING_DIR = os.environ.get("PLAN_PICK_PACING_DIR") or os.path.expanduser("~/.local/state/pacing")
LIMITS = os.path.expanduser("~/.local/state/token-ladder/lane-limits.json")
LAUNCHES = os.path.expanduser("~/.local/state/token-ladder/launches.jsonl")
CREDITS = os.path.expanduser("~/.local/state/token-ladder/lane-credits.json")
PI = os.path.expanduser("~/.npm-global/bin/pi")
PI_SESSIONS = os.path.expanduser("~/.pi/agent/sessions")
DEFAULT_CREDIT_FLOOR_USD = 2.0
DEFAULT_CREDIT_REFRESH_MINUTES = 30
DEFAULT_CREDIT_STALE_HOURS = 6
DEFAULT_LOOP_BASE_SECONDS = 7200
DEFAULT_LOOP_AHEAD_SECONDS = 10800
DEFAULT_LOOP_FAR_AHEAD_SECONDS = 14400
DEFAULT_LOOP_AHEAD_RATIO = 1.0
DEFAULT_LOOP_FAR_AHEAD_RATIO = 1.2
DEFAULT_LOOP_USED_PCT = 95
DEFAULT_LOOP_MIN_SECONDS = 1800
PLANS_NOTE = "Included means no extra cost: never quote API pricing or ask for a spend cap for these."


def number(value):
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) else None


def skip_reason(pool, warn, no_pace=False):
    if not isinstance(pool, dict):
        return None
    if pool.get("state") == "OFF" or (pool.get("funding") != "prepaid" and (number(pool.get("used_pct")) or 0) >= 100):
        return "used up" + (f": {pool['note']}" if pool.get("note") else "")
    ratio = number(pool.get("pace_ratio"))
    if not no_pace and ratio is not None and ratio > warn:
        return f"pace {ratio:.2f}x is above {warn:g}x"
    return None


def pool_note(pool, warn):
    if not isinstance(pool, dict):
        return "no usage reader, a 429 or empty credit marks it limited"
    if pool.get("note"):
        return pool["note"]
    if number(pool.get("pace_ratio")) is None:
        return "pace unknown, not ahead"
    return f"pace {pool['pace_ratio']:.2f}x, within {warn:g}x"


def resolve_burn_lane(spec, lanes):
    for lane in lanes:
        if lane["lane"] == spec or lane.get("pool") == spec:
            return lane["lane"]
    return None


def parse_burn(cfg, lanes, now=None):
    burn = cfg.get("burn") if isinstance(cfg, dict) else None
    if not isinstance(burn, dict):
        return None
    spec = burn.get("lane")
    until_s = burn.get("until")
    if not isinstance(spec, str) or not isinstance(until_s, str):
        return None
    try:
        until = datetime.fromisoformat(until_s)
        if until.tzinfo is None:
            until = until.replace(tzinfo=timezone.utc)
        until_ts = until.timestamp()
    except (ValueError, TypeError, OverflowError):
        return None
    now_ts = time.time() if now is None else now
    if now_ts >= until_ts:
        return None
    name = resolve_burn_lane(spec, lanes)
    if name is None:
        return None
    return {"lane": name, "until": until_ts}


def lanes_with_burn(lanes, burn):
    if not burn:
        return lanes
    name = burn["lane"]
    head = [lane for lane in lanes if lane["lane"] == name]
    if not head:
        return lanes
    tail = [lane for lane in lanes if lane["lane"] != name]
    return head + tail


def pick(lanes, pools, limits=None, now=None, warn=DEFAULT_PACE_WARN, burn=None):
    pools = pools if isinstance(pools, dict) else {}
    limits = limits if isinstance(limits, dict) else {}
    now = time.time() if now is None else now
    skipped, ahead = {}, {}
    for lane in lanes:
        name = lane["lane"]
        pool = pools.get(lane.get("pool")) or pools.get(f"credit:{lane.get('credit')}")
        if name == "google" or lane.get("pool") == "google" or (isinstance(pool, dict) and pool.get("chat_only")):
            skipped[name] = "chat-only pool, never workers"
            continue
        until = number(limits.get(name))
        if until is not None and until > now:
            skipped[name] = f"limited until {datetime.fromtimestamp(until, timezone.utc):%H:%M} UTC"
            continue
        no_pace = burn is not None and name == burn["lane"]
        why = skip_reason(pool, warn, no_pace)
        if why:
            skipped[name] = why
            if why.startswith("pace"):
                ahead[name] = number(pool.get("pace_ratio"))
            continue
        if no_pace:
            hh = datetime.fromtimestamp(burn["until"], timezone.utc).strftime("%H:%M")
            reason = f"burn: {name} first until {hh} UTC"
        else:
            reason = f"first lane that is not used up, limited or ahead of pace: {pool_note(pool, warn)}"
        if skipped:
            reason += "; skipped " + ", ".join(f"{p} ({w})" for p, w in skipped.items())
        return {"plan": name, "command": lane["command"], "reason": reason}
    if not ahead:
        reason = "every lane is used up or limited: " + ", ".join(f"{p} ({w})" for p, w in skipped.items())
        frees = {name: number(limits.get(name)) for name in skipped if (number(limits.get(name)) or 0) > now}
        next_free = None
        if frees:
            lane_name = min(frees, key=frees.get)
            next_free = {"lane": lane_name, "at": frees[lane_name]}
            reason += (f"; {lane_name} frees at {datetime.fromtimestamp(frees[lane_name], timezone.utc):%H:%M} UTC,"
                       " so wait for it and run plan-pick --run again")
        else:
            reason += "; wait for the next plan reset"
        return {"plan": "none", "command": None, "reason": reason, "next_free": next_free}
    name = min(ahead, key=ahead.get)
    lane = next(lane for lane in lanes if lane["lane"] == name)
    others = ", ".join(f"{p} ({w})" for p, w in skipped.items() if p != name)
    return {"plan": name, "command": lane["command"],
            "reason": f"every lane is ahead of pace, used up or limited; least ahead is {name} ({skipped[name]})"
            + (f"; skipped {others}" if others else "")}


def claude_helper(pools, warn=DEFAULT_PACE_WARN):
    pool = pools.get("claude") if isinstance(pools, dict) else None
    why = skip_reason(pool, warn)
    if why:
        return {"allowed": False, "reason": f"Claude is {why}, so no Claude helper"}
    if not isinstance(pool, dict):
        note = "no Claude reading, assumed under pace"
    elif number(pool.get("pace_ratio")) is None:
        note = "pace unknown, not ahead"
    else:
        note = f"pace {pool['pace_ratio']:.2f}x, within {warn:g}x"
    return {"allowed": True, "reason": f"Claude is under its pace: {note}"}


def loop_rule(cfg):
    raw = cfg.get("loop_interval") if isinstance(cfg, dict) else None
    raw = raw if isinstance(raw, dict) else {}

    def value(key, default):
        got = number(raw.get(key))
        return default if got is None else got

    return {"base_seconds": value("base_seconds", DEFAULT_LOOP_BASE_SECONDS),
            "ahead_seconds": value("ahead_seconds", DEFAULT_LOOP_AHEAD_SECONDS),
            "far_ahead_seconds": value("far_ahead_seconds", DEFAULT_LOOP_FAR_AHEAD_SECONDS),
            "ahead_ratio": value("ahead_ratio", DEFAULT_LOOP_AHEAD_RATIO),
            "far_ahead_ratio": value("far_ahead_ratio", DEFAULT_LOOP_FAR_AHEAD_RATIO),
            "used_pct": value("used_pct", DEFAULT_LOOP_USED_PCT),
            "min_seconds": value("min_seconds", DEFAULT_LOOP_MIN_SECONDS)}


def loop_answer(rule, seconds, ratio, used, reason):
    return {"seconds": max(int(seconds), int(rule["min_seconds"])), "pace_ratio": ratio,
            "used_pct": used, "reason": reason}


def loop_interval(pools, cfg):
    rule = loop_rule(cfg)
    pool = pools.get("claude") if isinstance(pools, dict) else None
    if not isinstance(pool, dict):
        return loop_answer(rule, rule["base_seconds"], None, None, "claude pool unknown")
    ratio = number(pool.get("pace_ratio"))
    used = number(pool.get("used_pct"))
    if used is not None and used >= rule["used_pct"]:
        return loop_answer(rule, rule["far_ahead_seconds"], ratio, used, f"claude {used:.0f}% used")
    if ratio is not None and ratio > rule["far_ahead_ratio"]:
        return loop_answer(rule, rule["far_ahead_seconds"], ratio, used, f"claude pace {ratio:.2f}x far ahead")
    if ratio is None:
        return loop_answer(rule, rule["base_seconds"], None, used, "claude pace unknown")
    if ratio > rule["ahead_ratio"]:
        return loop_answer(rule, rule["ahead_seconds"], ratio, used, f"claude pace {ratio:.2f}x ahead")
    return loop_answer(rule, rule["base_seconds"], ratio, used, f"claude pace {ratio:.2f}x on pace")


def loop_interval_answer(source, cfg):
    try:
        return loop_interval(read_pools(source), cfg)
    except Exception:
        return loop_interval({}, cfg)


def load_config():
    try:
        with open(os.path.join(HERE, "..", "config.json")) as fh:
            cfg = json.load(fh)
    except (OSError, ValueError):
        return {}
    if not isinstance(cfg, dict):
        return {}
    local_path = os.environ.get(
        "TOKEN_LADDER_LOCAL_CONFIG", os.path.join(HERE, "..", "config.local.json"))
    try:
        with open(local_path) as fh:
            local = json.load(fh)
        if isinstance(local, dict):
            cfg.update(local)
    except (OSError, ValueError):
        pass
    return cfg


def lanes_from(cfg):
    lanes = cfg.get("lanes")
    if not isinstance(lanes, list):
        return []
    return [lane for lane in lanes if isinstance(lane, dict) and isinstance(lane.get("lane"), str)
            and isinstance(lane.get("command"), str)]


def lane_names(lane):
    names = (lane.get("lane"), lane.get("vendor"), lane.get("credit"))
    return {name.lower() for name in names if isinstance(name, str)}


def plans_from(cfg):
    plans = cfg.get("plans")
    if not isinstance(plans, list):
        return []
    return [plan for plan in plans if isinstance(plan, dict) and isinstance(plan.get("name"), str)]


def plan_line(plan):
    models = ", ".join(str(model) for model in plan.get("included_models") or [])
    places = " and ".join(str(place) for place in plan.get("runs_on") or [])
    allowance = ""
    if number(plan.get("included_allowance_usd")) is not None:
        allowance = (f" ${plan['monthly_price_usd']:g}/month; "
                     f"${plan['included_allowance_usd']:g} included allowance.")
    state = f" Status: {plan['status']}. {plan['note']}." if plan.get("status") else ""
    line = (f"{plan['name']} ({plan.get('vendor')}): {models}. Runs on {places}.{allowance} "
            f"Extra cost: {plan.get('extra_cost')}. Source: {plan.get('source')}.{state}")
    if plan.get("pool"):
        usage = plan.get("usage") or {}
        used, limit, pace = (number(usage.get(key)) for key in ("used", "limit", "pace_ratio"))
        line += f" Pool: {plan['pool']}."
        if plan.get("chat_only"):
            line += " Chat-only, never workers."
        line += f" Used: {used:g}" if used is not None else " Used: unknown"
        if usage.get("unit"):
            line += f" {usage['unit']}"
        line += f". Limit: {limit:g}" if limit is not None else ". Limit: unknown"
        line += f". Pace: {pace:.2f}x." if pace is not None else ". Pace: unknown."
    return line



def read_limits(path=LIMITS):
    try:
        with open(path) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def mark_limited(lane, hours, now=None, path=LIMITS):
    now = time.time() if now is None else now
    limits = {k: v for k, v in read_limits(path).items() if (number(v) or 0) > now}
    limits[lane] = now + hours * 3600
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(limits, fh)
    os.replace(tmp, path)
    return limits[lane]


def limit_kind(code, tail):
    if code == 0:
        return None
    tail = tail[-ERROR_CHARS:]
    if CREDIT_ERROR.search(tail):
        return "credit"
    if BLOCKED_ERROR.search(tail):
        return "blocked"
    if RATE_ERROR.search(tail):
        return "rate"
    if not tail.strip():
        return "silent"
    return None


def fast_fail_kind(code, tail, elapsed, work):
    if code == 0 or work or elapsed >= FAST_FAIL_BEFORE_WORK_S:
        return None
    tail = tail[-ERROR_CHARS:]
    if MODEL_REJECTED.search(tail):
        return "model request was rejected"
    if PROVIDER_AUTH.search(tail):
        return "provider auth error"
    if PROVIDER_HTTP.search(tail):
        return "provider HTTP error"
    if PI_AGENT_FAST.search(tail):
        return "agent error before work"
    return None


def repo_work_mark(cwd):
    proc = subprocess.run(["git", "status", "--porcelain"], cwd=cwd, capture_output=True, text=True, timeout=5)
    return proc.stdout if proc.returncode == 0 else None


def worker_env(environ):
    env = {name: value for name, value in environ.items()
           if name != "HT_TOKEN" and not name.startswith("HYPERTASK_")
           and not name.startswith("MULTIPROMPT_")}
    env["PLAN_PICK_WORKER"] = "1"
    path = env.get("PATH")
    env["PATH"] = f"{WORKER_SHIMS}{os.pathsep}{path}" if path else WORKER_SHIMS
    return env


def run_command(command):
    proc = subprocess.Popen(["bash", "-c", command], stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace",
                            env=worker_env(os.environ))
    tail = ""
    for line in proc.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
        tail = (tail + line)[-TAIL_CHARS:]
    return proc.wait(), tail


def run_worker(command):
    cwd = os.getcwd()
    before = repo_work_mark(cwd)
    start = time.time()
    code, tail = run_command(command)
    elapsed = time.time() - start
    after = repo_work_mark(cwd)
    work = before is not None and before != after
    return code, tail, elapsed, work


def unpack_run(result):
    if len(result) == 2:
        return result[0], result[1], 0.0, False
    return result


def log_launch(path, lane, now, not_vendor):
    at = now if now is not None else time.time()
    line = {"at": at, "lane": lane,
            "session": os.environ.get("CLAUDE_CODE_SESSION_ID"), "cwd": os.getcwd(), "not_vendor": not_vendor,
            "caller": os.environ.get("MULTIBOT_SESSION") or os.getcwd()}
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a") as fh:
            fh.write(json.dumps(line) + "\n")
    except OSError as exc:
        print(f"plan-pick: launch log not written: {exc}", file=sys.stderr)
        return
    if lane is not None:
        stamp = datetime.fromtimestamp(at, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        print(f"Pacer launch: {lane} {stamp}", file=sys.stderr)
def run_lanes(lanes, pools, cfg, warn, runner=run_worker, limits_path=LIMITS, now=None, say=None,
              launches_path=LAUNCHES, not_vendor=None, burn=None):
    say = say or (lambda text: print(f"plan-pick: {text}", file=sys.stderr, flush=True))
    hours = {"rate": number(cfg.get("limited_hours")) or DEFAULT_LIMITED_HOURS,
             "silent": number(cfg.get("limited_hours")) or DEFAULT_LIMITED_HOURS,
             "credit": number(cfg.get("credit_limited_hours")) or DEFAULT_CREDIT_LIMITED_HOURS,
             "blocked": number(cfg.get("limited_hours")) or DEFAULT_LIMITED_HOURS}
    why = {"rate": "hit a rate or usage limit", "credit": "is out of credit", "silent": "exited with no output",
           "blocked": "was blocked by the provider's bot challenge"}
    tried = set()
    while True:
        result = pick([lane for lane in lanes if lane["lane"] not in tried], pools,
                      read_limits(limits_path), now, warn, burn)
        if not result["command"]:
            log_launch(launches_path, None, now, not_vendor)
            say(f"no lane left, nothing ran. {result['reason']}")
            return 4
        say(f"lane {result['plan']}: {result['reason']}")
        log_launch(launches_path, result["plan"], now, not_vendor)
        code, tail, elapsed, work = unpack_run(runner(result["command"]))
        kind = limit_kind(code, tail)
        if kind is None:
            skip = fast_fail_kind(code, tail, elapsed, work)
            if skip is None:
                return code
            tried.add(result["plan"])
            say(f"skipped lane {result['plan']}: {skip} (exit {code})")
            continue
        tried.add(result["plan"])
        until = mark_limited(result["plan"], hours[kind], now, limits_path)
        say(f"lane {result['plan']} {why[kind]} (exit {code}); skipped until "
            f"{datetime.fromtimestamp(until, timezone.utc):%Y-%m-%d %H:%M} UTC, trying the next lane")


def http_json(url, key):
    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {key}", "User-Agent": "token-ladder"})
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)


def pi_key(provider):
    out = subprocess.run([PI, "auth", "print-api-key", "--provider", provider],
                         capture_output=True, text=True, timeout=60)
    return out.stdout.strip() if out.returncode == 0 else ""


def balance_deepseek(get, key):
    infos = get("https://api.deepseek.com/user/balance", key("deepseek")).get("balance_infos") or []
    return sum(float(i["total_balance"]) for i in infos if i.get("currency") == "USD")


def balance_vercel(get, key):
    return float(get("https://ai-gateway.vercel.sh/v1/credits", key("vercel-ai-gateway"))["token_pass"]["remaining"])


def balance_openrouter(get, key):
    k = key("openrouter-credit")
    account = get("https://openrouter.ai/api/v1/credits", k)["data"]
    left = account["total_credits"] - account["total_usage"]
    remaining = number(get("https://openrouter.ai/api/v1/key", k)["data"].get("limit_remaining"))
    return left if remaining is None else min(left, remaining)


BALANCES = {"deepseek": balance_deepseek, "vercel": balance_vercel, "openrouter": balance_openrouter}


def read_credits(path=CREDITS):
    try:
        with open(path) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def refresh_credits(names, now, path=CREDITS, get=http_json, key=pi_key, readers=BALANCES):
    data = read_credits(path)
    for name in names:
        reader = readers.get(name)
        if not reader:
            continue
        try:
            data[name] = {"usd": round(reader(get, key), 2), "at": now}
        except Exception as exc:
            print(f"plan-pick: cannot read {name} credit: {type(exc).__name__}", file=sys.stderr)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh)
    os.replace(tmp, path)
    return data


def credit_pool(entry, now, cfg):
    stale_s = (number(cfg.get("credit_stale_hours")) or DEFAULT_CREDIT_STALE_HOURS) * 3600
    floor = number(cfg.get("credit_floor_usd"))
    floor = DEFAULT_CREDIT_FLOOR_USD if floor is None else floor
    if not isinstance(entry, dict) or number(entry.get("usd")) is None or number(entry.get("at")) is None:
        return None
    if now - entry["at"] > stale_s:
        return None
    if entry["usd"] < floor:
        return {"state": "OFF", "note": f"${entry['usd']:.2f} credit left, under ${floor:g}"}
    return {"state": "ON", "note": f"${entry['usd']:.2f} credit left"}


def refresh_later(names, now, path):
    subprocess.Popen([sys.executable, os.path.realpath(__file__), "--read-credits", *names],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    return read_credits(path)


def with_credits(pools, lanes, cfg, now=None, path=CREDITS, refresh=refresh_later):
    now = time.time() if now is None else now
    names = [lane["credit"] for lane in lanes if isinstance(lane.get("credit"), str)]
    data = read_credits(path)
    every = (number(cfg.get("credit_refresh_minutes")) or DEFAULT_CREDIT_REFRESH_MINUTES) * 60
    due = [n for n in names if now - (number((data.get(n) or {}).get("at")) or 0) > every]
    if due:
        data = refresh(due, now, path)
    pools = dict(pools) if isinstance(pools, dict) else {}
    for name in names:
        state = credit_pool(data.get(name), now, cfg)
        if state and f"credit:{name}" not in pools:
            pools[f"credit:{name}"] = state
    return pools


def history_rows(pacing_dir):
    try:
        with open(os.path.join(pacing_dir, "opencode-history.jsonl")) as fh:
            lines = fh.read().splitlines()
    except OSError:
        return []
    rows = []
    for line in lines:
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if isinstance(row, dict) and number(row.get("at")) is not None:
            rows.append(row)
    return rows


def parse_opencode_windows(raw):
    used = {}
    if not isinstance(raw, dict):
        return used
    for name, val in raw.items():
        if isinstance(val, dict):
            used[name] = number(val.get("used") if val.get("used") is not None else val.get("percent"))
        else:
            used[name] = number(val)
    return used


def last_windows(pacing_dir):
    rows = [r for r in history_rows(pacing_dir) if isinstance(r.get("windows"), dict) and r["windows"]]
    if not rows:
        return None
    row = max(rows, key=lambda r: r["at"])
    return {"at": row["at"], "used": parse_opencode_windows(row["windows"])}


def read_opencode(cfg):
    command = cfg.get("opencode_reader_command") or []
    if not isinstance(command, list) or not command or not all(isinstance(arg, str) for arg in command):
        raise ValueError("OpenCode reader command missing")
    command = [os.path.expanduser(arg) for arg in command]
    out = subprocess.run(command + ["--print"], capture_output=True, text=True, timeout=180, check=True)
    usage = json.loads(out.stdout)
    windows = usage["windows"]
    reading = {"at": datetime.fromisoformat(usage["measured_at"].replace("Z", "+00:00")).timestamp(),
               "windows": {w["name"]: w["used"] for w in windows},
               "resets_at": {w["name"]: w.get("resets_at") for w in windows}}
    try:
        out = subprocess.run(command + ["--credits", "--print"], capture_output=True, text=True,
                             timeout=180, check=True)
        money = json.loads(out.stdout)
        reading.update(credits_usd=money["credits_usd"], credits_at=money["at"])
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        pass
    return reading


def opencode_pool(now, cfg, pacing_dir=PACING_DIR):
    plan = next((p for p in plans_from(cfg) if p.get("vendor") == "opencode"), {})
    allowance = number(plan.get("included_allowance_usd"))
    try:
        reading = read_opencode(cfg)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        reading = None
    now = time.time() if now is None else now
    live = reading is not None
    reading = reading or last_windows(pacing_dir)
    if not reading:
        return {"state": "OFF", "note": "OpenCode live usage unavailable; never top up"}
    used = parse_opencode_windows(reading.get("windows", reading.get("used")))
    monthly = number(used.get("monthly"))
    windows = ", ".join(f"{name} {used[name]:g}%" if number(used.get(name)) is not None else f"{name} unknown"
                        for name in ("monthly", "weekly", "5-hour"))
    result = {"state": "OFF", "used_pct": monthly, "windows": used, "note": windows,
              "included_exhausted": monthly is not None and monthly >= 100}
    renewal = (reading.get("resets_at") or {}).get("monthly")
    if number(renewal) is None:
        try:
            renewal = datetime.fromisoformat(cfg["opencode_monthly_renewal"].replace("Z", "+00:00")).timestamp()
        except (KeyError, ValueError, TypeError):
            renewal = None
    result["resets_at"] = renewal
    if monthly is not None and allowance is not None and allowance > 0:
        result.update(used_usd=monthly * allowance / 100, included_allowance_usd=allowance)
        result["note"] += f"; ${result['used_usd']:.2f} of ${allowance:.2f} included allowance"
    if result["included_exhausted"]:
        result["note"] += "; included allowance used up"
    at = number(reading.get("at"))
    if not live or at is None or not 0 <= now - at <= 300:
        result["note"] += "; live usage unavailable or stale; never top up"
        return result
    if (monthly is None or not math.isfinite(monthly) or monthly < 0 or allowance is None
            or not math.isfinite(allowance) or allowance <= 0):
        result["note"] += "; allowance missing; never top up"
        return result
    if monthly < 100:
        if any((number(used.get(name)) or 0) >= 100 for name in ("rolling", "5-hour", "weekly")):
            result["note"] += "; window is full"
        else:
            result.update(state="ON", funding="included")
        return result
    credit, credit_at = number(reading.get("credits_usd")), number(reading.get("credits_at"))
    if credit is None or not math.isfinite(credit) or credit_at is None or not 0 <= now - credit_at <= 60:
        result["note"] += "; live credit unavailable or stale; never top up"
        return result
    floor = number(cfg.get("opencode_credit_floor_usd"))
    floor = 2 if floor is None or not math.isfinite(floor) or floor < 0 else floor
    result.update(credits_usd=credit, credit_floor_usd=floor)
    result["note"] += f"; live available credit ${credit:.2f} (floor ${floor:g}); never top up"
    if credit <= floor:
        result.update(floor_reached=True)
        result["note"] += "; skip until monthly renewal"
    elif cfg.get("opencode_extra_usage") is not True or cfg.get("opencode_auto_topup") is not False:
        result["note"] += "; prepaid usage requires Extra Usage on and auto top-up OFF"
    elif number(renewal) is None or not math.isfinite(renewal) or renewal <= now:
        result["note"] += "; monthly renewal needs a fresh reading"
    else:
        result.update(state="ON", funding="prepaid")
        result["note"] += "; using held prepaid credit"
    return result


def jsonl_rows(path):
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if isinstance(row, dict):
                    yield row
    except OSError:
        return


def burn_report(cfg, now=None, sessions=PI_SESSIONS, launches_path=LAUNCHES):
    now = time.time() if now is None else now
    month = datetime.fromtimestamp(now, timezone.utc).replace(day=1, hour=0, minute=0, second=0, microsecond=0)
    start = month.timestamp()
    providers = {"opencode-go": "opencode", "vercel-ai-gateway": "vercel", "openrouter-credit": "openrouter",
                 "openai-codex": "codex"}
    by_lane = {lane["lane"]: {"usd": None, "messages": 0, "unpriced_messages": 0, "launches": 0}
               for lane in lanes_from(cfg)}
    by_caller = {}

    def entry(table, name):
        return table.setdefault(name, {"usd": None, "messages": 0, "unpriced_messages": 0, "launches": 0})

    seen = set()
    for path in sorted(glob.glob(os.path.join(sessions, "*", "*.jsonl"))):
        caller = "unknown caller"
        for row in jsonl_rows(path):
            if row.get("type") == "session":
                caller = row.get("cwd") or "unknown caller"
            message = row.get("message")
            if not isinstance(message, dict) or message.get("role") != "assistant":
                continue
            at = number(message.get("timestamp"))
            provider = message.get("provider")
            if at is None or not start <= at / 1000 <= now or not isinstance(provider, str):
                continue
            if row.get("id"):
                identity = (provider, row["id"], at)
                if identity in seen:
                    continue
                seen.add(identity)
            usage = message.get("usage")
            cost = usage.get("cost") if isinstance(usage, dict) else None
            usd = number(cost.get("total")) if isinstance(cost, dict) else None
            for item in (entry(by_lane, providers.get(provider, provider)), entry(by_caller, caller)):
                item["messages"] += 1
                if usd is None:
                    item["unpriced_messages"] += 1
                else:
                    item["usd"] = (item["usd"] or 0) + usd
    for row in jsonl_rows(launches_path):
        at = number(row.get("at"))
        if at is None or not start <= at <= now or not row.get("lane"):
            continue
        caller = row.get("caller") or row.get("cwd") or "unknown caller"
        entry(by_lane, row["lane"])["launches"] += 1
        entry(by_caller, caller)["launches"] += 1
    return {"month": month.strftime("%Y-%m"), "currency": "USD", "by_lane": by_lane, "by_caller": by_caller,
            "measured": cfg.get("measured_burn", []),
            "note": "Recorded pi message costs, not invoices or extra-usage charges; no token-rate estimates. "
                    "Missing cost data is unknown. Callers use usage-store cwd or launch caller/cwd; "
                    "chat names and directories are separate when logs cannot link them."}


def burn_lines(report):
    yield f"Burn {report['month']} UTC (USD)"
    yield report["note"]
    for item in report.get("measured", []):
        per_billion = round(item["usd"] / (item["tokens"] / 1e9), 1)
        yield (f"Measured {item['lane']} direct, {item['period_days']} days ending {item['as_of']}: "
               f"${item['usd']:.2f} for {item['tokens'] / 1e9:.2f}B tokens over {item['requests']:,} requests; "
               f"about ${per_billion:.2f} per 1B tokens; ~{item['cached_pct']:g}% cached. "
               "Separate account measurement, not added to recorded pi costs.")
    for title, key in (("Per lane", "by_lane"), ("Per caller", "by_caller")):
        yield title
        for name, item in sorted(report[key].items()):
            usd = "unknown" if item["usd"] is None else f"${item['usd']:.4f}"
            yield (f"  {name}: {usd}; {item['messages']} messages; "
                   f"{item['unpriced_messages']} unpriced; {item['launches']} launches")


def read_pools(source):
    if source == "-":
        return json.load(sys.stdin)
    if source:
        with open(source) as fh:
            return json.load(fh)
    out = subprocess.run([sys.executable, os.path.join(HERE, "token-ladder"), "pools", "--json"],
                         capture_output=True, text=True, timeout=20, check=True).stdout
    return json.loads(out)


def with_opencode(pools, cfg, now=None):
    pools = pools if isinstance(pools, dict) else {}
    if "opencode" not in pools:
        state = opencode_pool(now, cfg)
        now = time.time() if now is None else now
        if state.get("floor_reached") and (number(state.get("resets_at")) or 0) > now:
            mark_limited("opencode", (state["resets_at"] - now) / 3600, now)
        pools = dict(pools, opencode=state)
    return pools


def main(argv):
    parser = argparse.ArgumentParser(prog="plan-pick", description="Pick the lane for the next background worker.")
    parser.add_argument("--json", action="store_true", help="print plan, command and reason as JSON")
    parser.add_argument("--burn", action="store_true", help="report this month's recorded spend per lane and caller")
    parser.add_argument("--plans", action="store_true",
                        help="print what each subscription includes, where it runs and whether it costs extra")
    parser.add_argument("--pools", metavar="FILE", help="read pool state from FILE or - for stdin instead of token-ladder")
    parser.add_argument("--claude-helper", action="store_true",
                        help="answer whether an in-chat Claude helper is allowed (exit 0 allowed, 3 refused)")
    parser.add_argument("--loop-interval", action="store_true",
                        help="print how many seconds a loop should wait before its next tick, from Claude's pace")
    parser.add_argument("--limited", metavar="LANE",
                        help="mark LANE limited after a 429, quota or empty-credit error; plan-pick skips it for a while")
    parser.add_argument("--not-vendor", metavar="VENDOR",
                        help="skip lanes from VENDOR, so a review comes from a different vendor than the author")
    parser.add_argument("--run", action="store_true",
                        help="run the picked lane's command; on a 429, 402, quota or no output mark it limited and run the next lane; on a fast provider failure before work, run the next lane")
    parser.add_argument("--read-credits", nargs="*", metavar="LANE",
                        help="read the credit balance of these lanes (all credit lanes when none) and store it")
    parser.add_argument("--hours", type=float, help="how long --limited skips the lane (default from config)")
    args = parser.parse_args(argv)
    cfg = load_config()
    if args.loop_interval:
        answer = loop_interval_answer(args.pools, cfg)
        if args.json:
            print(json.dumps(answer))
        else:
            print(f"{answer['seconds']} {answer['reason']}")
        return 0
    if args.burn:
        report = burn_report(cfg)
        print(json.dumps(report) if args.json else "\n".join(burn_lines(report)))
        return 0
    if args.plans:
        plans = plans_from(cfg)
        try:
            pools = read_pools(args.pools) if any(plan.get("pool") for plan in plans) else {}
        except (OSError, ValueError, subprocess.SubprocessError):
            pools = {}
        pools = pools if isinstance(pools, dict) else {}
        plans = [dict(plan, usage=pools.get(plan["pool"]) or {}) if plan.get("pool") else plan for plan in plans]
        state = opencode_pool(None, cfg)
        plans = [dict(plan, status=("included allowance used up; extra usage " + state["state"])
                      if state.get("included_exhausted") else state["state"], note=state["note"],
                      windows=state.get("windows", {}), credits_usd=state.get("credits_usd"),
                      resets_at=state.get("resets_at"))
                 if plan.get("vendor") == "opencode" else plan for plan in plans]

        if args.json:
            print(json.dumps(plans))
        else:
            for plan in plans:
                print(plan_line(plan))
            print(PLANS_NOTE)
        return 0
    warn = number(cfg.get("pace_warn_ratio")) or DEFAULT_PACE_WARN
    lanes = lanes_from(cfg)
    if args.read_credits is not None:
        names = args.read_credits or [lane["credit"] for lane in lanes if isinstance(lane.get("credit"), str)]
        lock = CREDITS + ".lock"
        os.makedirs(os.path.dirname(lock), exist_ok=True)
        try:
            if time.time() - os.path.getmtime(lock) < 120:
                return 0
        except OSError:
            pass
        open(lock, "w").close()
        try:
            data = refresh_credits(names, time.time())
        finally:
            os.unlink(lock)
        print(", ".join(f"{n} ${data[n]['usd']:.2f}" for n in names if n in data))
        return 0
    if args.limited:
        if args.limited not in {lane["lane"] for lane in lanes}:
            print(f"plan-pick: unknown lane {args.limited}; lanes: {', '.join(l['lane'] for l in lanes)}", file=sys.stderr)
            return 2
        hours = args.hours if args.hours is not None else number(cfg.get("limited_hours")) or DEFAULT_LIMITED_HOURS
        until = mark_limited(args.limited, hours)
        print(f"Lane {args.limited} is skipped until {datetime.fromtimestamp(until, timezone.utc):%Y-%m-%d %H:%M} UTC.")
        return 0
    try:
        pools = with_opencode(read_pools(args.pools), cfg)
        if not args.pools:
            pools = with_credits(pools, lanes, cfg)
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f"plan-pick: cannot read pool state: {exc}", file=sys.stderr)
        return 1
    if args.claude_helper:
        answer = claude_helper(pools, warn)
        if args.json:
            print(json.dumps(answer))
        else:
            print(f"Claude helper: {'allowed' if answer['allowed'] else 'refused'}. Why: {answer['reason']}.")
        return 0 if answer["allowed"] else 3
    if args.not_vendor:
        excluded = args.not_vendor.lower()
        lanes = [lane for lane in lanes if excluded not in lane_names(lane)]
    burn = parse_burn(cfg, lanes)
    lanes = lanes_with_burn(lanes, burn)
    if args.run:
        return run_lanes(lanes, pools, cfg, warn, not_vendor=args.not_vendor, burn=burn)
    result = pick(lanes, pools, read_limits(), warn=warn, burn=burn)
    if args.json:
        print(json.dumps(result))
    elif result["command"]:
        vendor_flag = f" --not-vendor {args.not_vendor}" if args.not_vendor else ""
        print(f"Worker plan: {result['plan']}. Launch: ~/.local/bin/plan-pick --run{vendor_flag} (reads brief.txt, runs {result['command']}, "
              f"moves to the next lane on a 429). Why: {result['reason']}.")
    else:
        print(f"Worker plan: none. Why: {result['reason']}.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
