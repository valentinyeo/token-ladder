#!/usr/bin/env python3
import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import uuid


def save_checkpoint(args):
    if not args.session.strip() or len(args.session) > 128:
        raise ValueError("session must contain 1-128 characters")
    if not args.next.strip() or len(args.next) > 4096:
        raise ValueError("next action must contain 1-4096 characters")
    if not re.fullmatch(r"https://app\.hypertask\.ai/detail/project-[1-9]\d*/[1-9]\d*", args.ticket):
        raise ValueError("ticket must be a full Hypertask ticket URL")
    if args.pr and not re.fullmatch(r"https://github\.com/[\w.-]+/[\w.-]+/pull/[1-9]\d*", args.pr):
        raise ValueError("review must be a full GitHub pull request URL")
    try:
        repo = subprocess.check_output(["git", "-C", args.repo, "rev-parse", "--show-toplevel"], text=True, stderr=subprocess.DEVNULL).strip()
        head = subprocess.check_output(["git", "-C", repo, "rev-parse", "HEAD"], text=True, stderr=subprocess.DEVNULL).strip()
        branch = subprocess.run(["git", "-C", repo, "symbolic-ref", "--quiet", "--short", "HEAD"], capture_output=True, text=True)
        if branch.returncode not in (0, 1):
            raise ValueError("cannot read the current branch")
        dirty = subprocess.check_output(["git", "-C", repo, "status", "--porcelain=v1", "--untracked-files=normal"], text=True, stderr=subprocess.DEVNULL).splitlines()
    except subprocess.CalledProcessError as error:
        raise ValueError("repository must have a readable committed revision") from error
    checkpoint_id = str(uuid.uuid4())
    record = {
        "version": 1,
        "id": checkpoint_id,
        "createdAt": datetime.now(timezone.utc).isoformat(),
        "session": args.session,
        "role": args.role,
        "harness": args.harness,
        "ticket": args.ticket,
        "pullRequest": args.pr,
        "next": args.next,
        "workspace": {"path": repo, "head": head, "branch": branch.stdout.strip() or None, "dirty": dirty},
    }
    folder = Path.home() / ".local/state/token-ladder/checkpoints"
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    target = folder / f"{checkpoint_id}.json"
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=folder, prefix=".checkpoint-", delete=False) as output:
            temporary = Path(output.name)
            json.dump(record, output, indent=2)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.link(temporary, target)
        temporary.unlink()
        descriptor = os.open(folder, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    finally:
        if temporary and temporary.exists():
            temporary.unlink()
    return target


def main(argv=None):
    parser = argparse.ArgumentParser(prog="tl-checkpoint")
    parser.add_argument("--session", required=True)
    parser.add_argument("--role", required=True, choices=("runner", "manager"))
    parser.add_argument("--harness", required=True, choices=("claude", "codex", "hax", "pi", "grok"))
    parser.add_argument("--repo", required=True)
    parser.add_argument("--ticket", required=True)
    parser.add_argument("--pr")
    parser.add_argument("--next", required=True)
    args = parser.parse_args(argv)
    try:
        path = save_checkpoint(args)
    except (ValueError, OSError) as error:
        print(f"tl-checkpoint: {error}", file=sys.stderr)
        return 2
    print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
