def hook_prompt():
    try:
        sid = json.loads(sys.stdin.read() or "{}").get("session_id") if not sys.stdin.isatty() else None
        if sid and sid in open(os.path.expanduser("~/.local/state/alert-mute/sessions")).read().split():
            return
    except (OSError, ValueError):
        pass
    try:
        s = load_status()
    except (OSError, ValueError):
        return
    if "--account" in sys.argv:
        print(token_max_line(s, sys.argv[sys.argv.index("--account") + 1]))


def token_max_line(s, account_id):
    """For a plan outside the ladder: one line telling its sessions how hard to push."""
    a = next((x for x in s.get("accounts", []) if x["id"] == account_id), None)
    if not a or a["week"]["used"] is None:
        return f"Token max: no numbers for {account_id} yet. " + onepassword_note(s)
    w = a["week"]
    behind = w["time_gone"] - w["used"]
    if behind > 10:
        push = ("Plenty left: work in parallel, hand side tasks to Agent subagents, and do the thorough version "
                "(extra checks, tests, reviews) rather than the cheap one.")
    elif behind < -10:
        push = "Ahead of pace: keep to the essentials so the plan lasts until the reset."
    else:
        push = "On pace: work normally."
    return (f"Token max ({a['label']}, {a['email']}): {w['used']:.0f}% used with {w['time_gone']:.0f}% of the week gone, "
            f"resets in {w['hours_left']:.0f} h. {push} " + onepassword_note(s))


WRAPPERS = {"nohup", "setsid", "env", "exec", "nice", "time", "command", "stdbuf"}


def shell_commands(cmd):
    lines, kept, i = cmd.split("\n"), [], 0
    while i < len(lines):
        kept.append(lines[i])
        m = re.search(r"<<-?\s*['\"]?(\w+)", lines[i])
        if m:
            i += 1
            while i < len(lines) and lines[i].strip() != m.group(1):
                i += 1
        i += 1
    lexer = shlex.shlex("\n".join(kept), posix=True, punctuation_chars=";&|()<>\n")
    lexer.whitespace = " \t\r"
    lexer.whitespace_split = True
    try:
        tokens = list(lexer)
    except ValueError:
        return []
    commands, words = [], []
    for token in tokens + [";"]:
        if token and all(c in ";&|()<>\n" for c in token):
            if words:
                commands.append(words)
            words = []
        else:
            words.append(token)
    result = []
    for words in commands:
        env = {}
        while words:
            word = words[0]
            if re.match(r"^\w+=", word):
                key, value = word.split("=", 1)
                env[key] = value
                words = words[1:]
            elif os.path.basename(word) in WRAPPERS:
                words = words[1:]
            elif word == "timeout":
                words = words[2:]
            elif word.startswith("-"):
                words = words[1:]
            else:
                break
        if words:
            result.append((words, env))
    return result


def launches_hax(cmd):
    return any(os.path.basename(words[0]) == "hax" for words, env in shell_commands(cmd))


PI_LANE_PROVIDERS = ("vercel-ai-gateway", "deepseek", "opencode-go", "commandcode", "openrouter-credit")
DEEPSEEK_FLASH_MODELS = ("deepseek/deepseek-v4.1-flash", "deepseek-v4.1-flash", "deepseek-flash")


def bash_refusal(cmd, environment=None):
    environment = os.environ if environment is None else environment
    for words, assigned in shell_commands(cmd):
        exe = os.path.basename(words[0])
        env = dict(environment, **assigned)
        if exe in ("cc-deepseek-apikey", "ccr") and env.get("TOKEN_LADDER_DEEPSEEK_OK") != "1":
            return "no DeepSeek fallback (Valentin 2026-10-25)"
        if exe not in ("claude", "hax", "codex", "pi", "cursor", "cursor-agent", "agent", "grok"):
            continue
        models, providers = [], []
        for i, word in enumerate(words[1:], 1):
            if word == "--provider" and i + 1 < len(words):
                providers.append(words[i + 1])
            elif word.startswith("--provider="):
                providers.append(word.split("=", 1)[1])
            if word in ("--model", "--model-id", "-m") and i + 1 < len(words):
                models.append(words[i + 1])
            elif word.startswith(("--model=", "--model-id=", "-m=")):
                models.append(word.split("=", 1)[1])
            elif word.startswith("-m") and len(word) > 2:
                models.append(word[2:])
            elif re.match(r"model\s*=", word):
                models.append(word.split("=", 1)[1].strip("\"'"))
        if any("fast" in model.lower() for model in models):
            return "Token ladder: fast mode is off; refuse any model id containing 'fast'."
        providers = [p.lower() for p in providers]
        if any("baseten" in w.lower() for w in words[1:]):
            return "Token ladder: never Baseten (Valentin 2026-11-19)."
        if "openrouter" in providers and env.get("TOKEN_LADDER_OPENROUTER_OK") != "1":
            return "Token ladder: OpenRouter runs only as the openrouter-credit lane plan-pick prints."
        deepseek_only = exe == "pi" and models and all(m.lower().startswith(DEEPSEEK_FLASH_MODELS) for m in models)
        if (any(w == "--api-key" or w.startswith("--api-key=") for w in words[1:]) or
                any(p not in ("codex", "openrouter") and not (p in PI_LANE_PROVIDERS and deepseek_only) for p in providers)):
            return "Token ladder: only the lanes plan-pick prints; DeepSeek Flash on pi, no paid-key fallback."
    return None


def hook_bash():
    try:
        cmd = json.load(sys.stdin).get("tool_input", {}).get("command", "")
    except ValueError:
        return
    reason = bash_refusal(cmd)
    if reason:
        deny(reason)


def hook_agent():
    try:
        event = json.load(sys.stdin)
    except ValueError:
        return
    if not isinstance(event, dict) or not isinstance(event.get("tool_input"), dict):
        return
    if "fast" in str(event["tool_input"].get("model", "")).lower():
        deny("Token ladder: fast mode is off; refuse any model id containing 'fast'.")
    if current_pools()["claude"]["state"] == "OFF":
        deny("Token ladder: Claude pool OFF; wait for its reset, no paid fallback.")


def deny(reason):
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                             "permissionDecisionReason": reason}}))
    sys.exit(0)


def set_mode(m):
    if m not in ("claude", "codex", "auto"):
        sys.exit("usage: token-ladder mode claude|codex|auto")
    cfg = load_config()
    if socket.gethostname() != cfg["primary_hostname"]:
        sys.exit(subprocess.run(["ssh", cfg["primary_ssh"], "projects/token-ladder/bin/token-ladder", "mode", m]).returncode)
    os.makedirs(STATE, exist_ok=True)
    if m == "auto":
        if os.path.exists(OVERRIDE):
            os.remove(OVERRIDE)
    else:
        with open(OVERRIDE, "w") as f:
            f.write(m)
    collect()


def route_command():
    parser = argparse.ArgumentParser(prog="token-ladder route")
    parser.add_argument("--repo", required=True)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(sys.argv[2:])
    try:
        with open(STATUS) as f:
            status_data = json.load(f)
    except (OSError, ValueError):
        status_data = {}
    if not isinstance(status_data, dict):
        status_data = {}
    mode = status_data.get("mode") or "codex"
    destination, command = route_line(args.repo, mode, status_data.get("cloud"))
    if args.json:
        print(json.dumps({"destination": destination, "command": command, "mode": mode, "repo": args.repo}))
    else:
        print(destination + "\t" + command)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    commands = {"collect": collect, "status": status, "hook-prompt": hook_prompt, "hook-bash": hook_bash,
                "hook-agent": hook_agent, "pools": pools_command, "grok-set": grok_set_command,
                "route": route_command, "mode": lambda: set_mode(sys.argv[2] if len(sys.argv) > 2 else "")}
    if cmd not in commands:
        sys.exit(f"token-ladder: unknown command: {cmd}\n\n{__doc__}")
    commands[cmd]()
